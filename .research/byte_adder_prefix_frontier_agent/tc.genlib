GATE ZERO 0 Y=CONST0;
GATE ONE 0 Y=CONST1;
GATE BUF 0 Y=A;
PIN * NONINV 1 999 0 0 0 0
GATE NOT 1 Y=!A;
PIN * INV 1 999 1 0 1 0
GATE AND 1 Y=A*B;
PIN * NONINV 1 999 1 0 1 0
GATE OR 1 Y=A+B;
PIN * NONINV 1 999 1 0 1 0
GATE NAND 1 Y=!(A*B);
PIN * INV 1 999 1 0 1 0
GATE NOR 1 Y=!(A+B);
PIN * INV 1 999 1 0 1 0
GATE XOR 3 Y=(A*!B)+(!A*B);
PIN * UNKNOWN 1 999 2 0 2 0
GATE XNOR 3 Y=(A*B)+(!A*!B);
PIN * UNKNOWN 1 999 2 0 2 0
