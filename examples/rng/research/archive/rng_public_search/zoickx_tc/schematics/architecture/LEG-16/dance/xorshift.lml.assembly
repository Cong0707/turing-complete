#include "leg.lml"
const mov i1|add
const sav i1|i2|add
const neg i1|sub
const uj i1|i2|j
const ucall i1|i2|call
const _ 0
const ptr f
const bnot bnand
const true 1
const false 0
#########################
#include "robot.lml"
const left  0
const step  1
const right 2
const chill 3
const actn  4
const pew   5
const do    sav
#########################

const curr a
const tmp b

mov _ io curr

label dance
	i2|div curr 2 tmp
	xor tmp curr curr

	i2|mul curr 2 tmp
	xor tmp curr curr

	i2|div curr 4 tmp
	xor tmp curr curr

	i2|mod curr 4 io
uj _ _ dance