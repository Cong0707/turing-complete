#include "leg.lml"
const mov i1|add
const li i1|i2|add
const _ 0
const uj i1|i2|j
const ucall i1|i2|call
#########################

const step a
const quad b
const shift c
const dir d

label hilbert_loop

	li _ 1 shift

	# skip all "small" 3rd quadrants
	label prep
		ucall _ _ next_quad
	i2|j|eq quad 3 prep

	# initial direction found
	i2|add quad 3 dir

	# rotate direction based on
	# larger quadrants
	uj _ _ while
	label rotate
		ucall _ _ next_quad

		i1|j|ult 0 quad noflip0
			i1|sub 3 dir dir
		label noflip0
		i2|j|ult quad 3 noflip3
			i1|sub 1 dir dir
		label noflip3
	label while
	i2|j|neq shift 64 rotate

	i2|mod dir 4 io

	i2|add step 1 step

uj _ _ hilbert_loop

# get next quadrant based on
# next two bits of step no.
label next_quad
	div step shift quad
	i2|mod quad 4 quad
	i2|mul shift 4 shift
mov _ stack iar